<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

	<changeSet id="20241807090100-0" author="arte">
		<createSequence sequenceName="threads_execution_id_seq" startValue="10" incrementBy="50" />
	</changeSet>

	<changeSet id="20241807090100-1" author="arte">
		<renameTable newTableName="tb_threads_executions" oldTableName="computational_threads_executions" />
	</changeSet>

	<changeSet id="20241807090100-2" author="arte">
		<dropForeignKeyConstraint baseTableName="tb_threads_executions"
			constraintName="fk_execution_computational_thread_id" />
	</changeSet>

	<changeSet id="20241807090100-3" author="arte">
		<addForeignKeyConstraint baseColumnNames="computational_thread_fk"
			baseTableName="tb_threads_executions" constraintName="fk_execution_thread_id"
			referencedColumnNames="id" referencedTableName="tb_threads" />
	</changeSet>

</databaseChangeLog>
