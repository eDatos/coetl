<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

	<changeSet id="20241807090000-0" author="arte">
		<renameSequence newSequenceName="threads_etls_id_seq"
			oldSequenceName="computational_threads_etls_id_seq" />
	</changeSet>

	<changeSet id="20241807090000-1" author="arte">
		<renameTable newTableName="tb_threads_etls" oldTableName="computational_threads_etls" />
	</changeSet>

	<changeSet id="20241807090000-2" author="arte">
		<dropForeignKeyConstraint baseTableName="tb_threads_etls"
			constraintName="fk_computational_threads_id" />
	</changeSet>

	<changeSet id="20241807090000-3" author="arte">
		<addForeignKeyConstraint baseColumnNames="id_computational_thread"
			baseTableName="tb_threads_etls" constraintName="fk_threads_id"
			referencedColumnNames="id" referencedTableName="tb_threads" />
	</changeSet>

	<changeSet id="20241807090000-4" author="arte">
		<dropForeignKeyConstraint baseTableName="tb_threads_etls"
			constraintName="fk_computational_thread_etl_id" />
	</changeSet>

	<changeSet id="20241807090000-5" author="arte">
		<addForeignKeyConstraint baseColumnNames="id_etl"
			baseTableName="tb_threads_etls" constraintName="fk_thread_etl_id"
			referencedColumnNames="id" referencedTableName="tb_etls" />
	</changeSet>

	<changeSet id="20241807090000-6" author="arte">
		<dropUniqueConstraint constraintName="unique_computational_thread_etl"
			tableName="tb_threads_etls" />
	</changeSet>

	<changeSet id="20241807090000-7" author="arte">
		<addUniqueConstraint columnNames="id_computational_thread, id_etl"
			constraintName="unique_thread_etl" tableName="tb_threads_etls" />
	</changeSet>

</databaseChangeLog>
