<?xml version="1.0" encoding="UTF-8"?>

<configuration scan="true">
  <include resource="org/springframework/boot/logging/logback/defaults.xml" />

  <turboFilter class="es.gobcan.istac.coetl.util.ExpiringDuplicateMessageFilter">
	<allowedRepetitions>4</allowedRepetitions>
	<cacheSize>200</cacheSize>
	<expireAfterWriteSeconds>1800</expireAfterWriteSeconds>
  </turboFilter>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level
        %logger{36} - %msg %n</pattern>
    </encoder>
  </appender>

  <logger name="es.gobcan.istac.coetl" level="#logback.loglevel#" />

  <logger name="io.github.jhipster" level="#logback.loglevel#" />

  <logger name="javax.activation" level="WARN" />
  <logger name="javax.mail" level="WARN" />
  <logger name="javax.xml.bind" level="WARN" />
  <logger name="ch.qos.logback" level="WARN" />
  <logger name="com.codahale.metrics" level="WARN" />
  <logger name="com.ryantenney" level="WARN" />
  <logger name="com.sun" level="WARN" />
  <logger name="com.zaxxer" level="WARN" />
  <logger name="io.undertow" level="WARN" />
  <logger name="io.undertow.websockets.jsr" level="ERROR" />
  <logger name="org.ehcache" level="WARN" />
  <logger name="org.apache" level="WARN" />
  <logger name="org.apache.catalina.startup.DigesterFactory"
    level="OFF" />
  <logger name="org.bson" level="WARN" />
  <logger name="org.hibernate.validator" level="WARN" />
  <logger name="org.hibernate" level="WARN" />
  <logger name="org.hibernate.ejb.HibernatePersistence" level="OFF" />
  <logger name="org.springframework" level="WARN" />
  <logger name="org.springframework.web" level="WARN" />
  <logger name="org.springframework.security" level="WARN" />
  <logger name="org.springframework.cache" level="WARN" />
  <logger name="org.thymeleaf" level="WARN" />
  <logger name="org.xnio" level="WARN" />
  <logger name="springfox" level="WARN" />
  <logger name="sun.rmi" level="WARN" />
  <logger name="liquibase" level="WARN" />
  <logger name="LiquibaseSchemaResolver" level="INFO" />
  <logger name="sun.rmi.transport" level="WARN" />

  <!-- <logger name="org.hibernate.SQL" level="DEBUG"/> -->
  <!-- <logger name="org.hibernate.type" level="TRACE"/> -->

  <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
    <resetJUL>true</resetJUL>
  </contextListener>

  <logger name="coetl" level="#logback.loglevel#">
    <appender-ref ref="STDOUT"/>
  </logger>

  <root level="#logback.loglevel#">
    <appender-ref ref="STDOUT" />
  </root>

</configuration>
